{
  "name": "charon-identity",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "Charon — интерактивная персональная цифровая идентичность.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:policy && playwright test",
    "typecheck": "tsc --noEmit",
    "standalone": "node scripts/standalone.mjs",
    "test:policy": "node --test checks/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
